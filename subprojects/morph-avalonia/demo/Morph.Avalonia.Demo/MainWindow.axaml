<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:Mostlylucid.Morph.Avalonia;assembly=Mostlylucid.Morph.Avalonia"
        x:Class="Morph.Avalonia.Demo.MainWindow"
        Title="Document ledger · concept demo" Width="1440" Height="940" MinWidth="1020" MinHeight="650">
  <Window.Styles>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,8" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#111D2D" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="DOCUMENT LEDGER" Foreground="#72DCC6" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <TextBlock Text="See the source. Teach the next import." Foreground="White" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="WordSampleButton" Content="Word example" Background="#24364A" Foreground="White" />
          <Button x:Name="HtmlSampleButton" Content="HTML example" Background="#24364A" Foreground="White" />
          <Button x:Name="NextDocumentButton" Content="Next document" IsVisible="False" Background="#24364A" Foreground="White" />
          <Button x:Name="OpenButton" Content="Open document…" Background="#72DCC6" Foreground="#111D2D" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,5,410">
      <viewer:MorphDocumentViewer x:Name="Viewer" />
      <GridSplitter Grid.Column="1" Background="#D7E1E9" ResizeDirection="Columns" />
      <Border Grid.Column="2" Background="#F4F7FA" Padding="20,16">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="IMPORTED RECORD" FontWeight="SemiBold" Foreground="#40576A" LetterSpacing="1" />
          <TextBlock Grid.Row="1" Text="Select a field to see its source. Correct it, or draw a region to replace its evidence." Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#526778" />
          <TabControl Grid.Row="2">
            <TabItem Header="Fields" x:Name="FieldsTab">
              <ScrollViewer>
                <StackPanel Spacing="12" Margin="0,12,0,0">
                  <WrapPanel>
                    <Button x:Name="NewTemplateButton" Content="New template" Margin="0,0,6,6" />
                    <Button x:Name="SuggestButton" Content="Suggest with local LLM" Margin="0,0,0,6" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="NewFieldName" PlaceholderText="New field name, e.g. Shipping address" />
                    <Button x:Name="AddFieldButton" Grid.Column="1" Content="Add" Margin="6,0,0,0" />
                  </Grid>
                  <CheckBox x:Name="ReuseTemplateBox" Content="Reuse this draft on the next document" />
                  <ScrollViewer MaxHeight="170"><StackPanel x:Name="EvidencePanel" Spacing="8" /></ScrollViewer>
                  <Separator />
                  <TextBlock x:Name="SelectedFieldLabel" Text="Select a field" FontWeight="SemiBold" FontSize="17" />
                  <TextBox x:Name="FieldValueBox" PlaceholderText="Corrected value" />
                  <TextBox x:Name="AnchorBox" PlaceholderText="Source label / anchor for future imports" />
                  <Expander Header="Neighborhood / section">
                    <TextBox x:Name="SectionBox" PlaceholderText="Section heading (optional)" />
                  </Expander>
                  <Button x:Name="ConfirmButton" Content="Confirm correction" HorizontalAlignment="Stretch" IsEnabled="False" />
                  <TextBlock x:Name="SelectionLocation" TextWrapping="Wrap" Foreground="#526778" />
                  <TextBlock Text="Captured source text" FontWeight="SemiBold" />
                  <TextBox x:Name="SelectionText" Text="Use Select region, then drag over the document." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxHeight="80" />
                  <Button x:Name="UseSelectionButton" Content="Use selection for this field" HorizontalAlignment="Stretch" IsEnabled="False" />
                  <TextBlock Text="Corrections feed this draft. Label, neighbors and position seed the centroid; multimodal embeddings are a follow-on experiment." FontSize="12" TextWrapping="Wrap" Foreground="#526778" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="YAML" x:Name="LedgerTab">
              <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                <TextBlock Text="Editable demo state: values, review status and evidence. Changes stay in this session." TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBox x:Name="LedgerEditor" Grid.Row="1" FontFamily="Menlo,Consolas,monospace" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" />
                <Button x:Name="ApplyLedgerButton" Grid.Row="2" Content="Apply YAML" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
              </Grid>
            </TabItem>
            <TabItem Header="Settings" x:Name="SettingsTab">
              <StackPanel Spacing="10" Margin="0,12,0,0">
                <TextBlock Text="Local template starter" FontWeight="SemiBold" />
                <TextBlock Text="Ollama endpoint" />
                <TextBox x:Name="EndpointBox" Text="http://localhost:11434" />
                <TextBlock Text="Installed generative model" />
                <TextBox x:Name="ModelBox" Text="qwen3.5:0.8b" />
                <TextBlock Text="Suggest with local LLM reads the first three pages (up to 16,000 characters). It proposes fields and anchors; source matches are checked before attaching evidence. No model is downloaded." TextWrapping="Wrap" />
                <TextBlock Text="Tev/Nimble will rank candidates once templates exist. A generative local model bootstraps new field names." TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#E6EEF3" Padding="20,9">
      <TextBlock x:Name="DemoStatus" Text="Loading synthetic example…" Foreground="#40576A" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
