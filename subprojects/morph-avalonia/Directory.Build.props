<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Papyrine_SponsorshipExemption>OpenSource</Papyrine_SponsorshipExemption>
    <Papyrine_SponsorshipExemptionUntil>2027-09</Papyrine_SponsorshipExemptionUntil>
  </PropertyGroup>
</Project>
